# Development Cognito public configuration. Copy to .env.local and use the
# development user pool/app clients; none of these values are secrets.
EXPO_PUBLIC_COGNITO_REGION=us-east-1
EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_REPLACE_ME
EXPO_PUBLIC_COGNITO_DOMAIN=https://REPLACE_ME.auth.us-east-1.amazoncognito.com
EXPO_PUBLIC_COGNITO_ANDROID_CLIENT_ID=REPLACE_ME
EXPO_PUBLIC_COGNITO_WEB_CLIENT_ID=REPLACE_ME
